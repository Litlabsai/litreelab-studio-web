---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | LiTree Lab Studio™</title>
    <style>
    /* TailwindCSS Enhancements */
    @apply bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 text-white;
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      .app {
        display: flex;
        min-height: 100vh;
      }
      .sidebar {
        width: 260px;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.5rem;
      }
      .header {
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(10px);
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100vh;
        color: #fff;
      }
      .app {
        display: flex;
        min-height: 100vh;
      }
      .sidebar {
        width: 260px;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.5rem;
      }
      .logo {
        font-size: 1.25rem;
        font-weight: bold;
        background: linear-gradient(90deg, #e94560, #ff6b6b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 2rem;
        text-decoration: none;
        display: block;
      }
      .nav-menu {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.8);
        transition: all 0.3s;
      }
      .nav-item:hover, .nav-item.active {
        background: rgba(233, 69, 96, 0.2);
        color: #fff;
      }
      .nav-item.active {
        border-left: 3px solid #e94560;
      }
      .nav-icon {
        font-size: 1.25rem;
        width: 1.5rem;
        text-align: center;
      }
      .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .top-bar {
        background: rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(10px);
        padding: 1rem 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .page-title {
        font-size: 1.5rem;
        font-weight: 600;
      }
      .content {
        flex: 1;
        padding: 2rem;
        overflow-y: auto;
      }
      .back-link {
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        transition: color 0.3s;
      }
      .back-link:hover {
        color: #e94560;
      }
    </style>
  </head>
  <body>
      <div class="app">
        <nav class="sidebar">
                <div class="profile flex items-center mb-4">
                  <img src="/path/to/profile-pic.jpg" alt="Profile Picture" class="w-16 h-16 rounded-full mr-4" />
                  <div>
                    <h3 class="text-lg font-bold">User Name</h3>
                    <p class="text-sm text-gray-400">@username</p>
                  </div>
                </div>
                <h2 class="logo">LiTree Lab Studio</h2>
                <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/feed">Feed</a></li>
            <li><a href="/profile">Profile</a></li>
            <li><a href="/settings">Settings</a></li>
          </ul>
        </nav>
        <div class="content">
          <header class="header flex justify-between items-center">
                    <h1>Welcome to LiTree Lab Studio</h1>
                    <div class="settings-dropdown relative">
                      <button class="settings-btn bg-gray-700 text-white px-4 py-2 rounded">Settings</button>
                      <ul class="dropdown-menu absolute right-0 mt-2 bg-white text-black shadow-lg hidden">
                        <li><a href="/profile" class="block px-4 py-2 hover:bg-gray-200">Profile</a></li>
                        <li><a href="/settings" class="block px-4 py-2 hover:bg-gray-200">Settings</a></li>
                        <li><a href="/logout" class="block px-4 py-2 hover:bg-gray-200">Logout</a></li>
                      </ul>
                    </div>
                  </header>
          <main>
            <slot />

            <!-- Chatbot Integration -->
            <div class="chatbot-wrapper">
              <Chatbot />
            </div>
          </main>
        </div>
      </div>
    <div class="app">
      <aside class="sidebar">
        <a href="/" class="logo">🧬 LiTree Lab Studio™</a>
        <nav class="nav-menu">
          <a href="/friends" class="nav-item">
            <span class="nav-icon">👥</span>
            <span>Friends</span>
          </a>
          <a href="/messages" class="nav-item">
            <span class="nav-icon">💬</span>
            <span>Messages</span>
          </a>
          <a href="/groups" class="nav-item">
            <span class="nav-icon">📚</span>
            <span>Groups</span>
          </a>
          <a href="/events" class="nav-item">
            <span class="nav-icon">📅</span>
            <span>Events</span>
          </a>
          <a href="/marketplace" class="nav-item">
            <span class="nav-icon">🛒</span>
            <span>Marketplace</span>
          </a>
          <a href="/agent-chat" class="nav-item">
            <span class="nav-icon">🤖</span>
            <span>Agent Chat</span>
          </a>
          <a href="/explain" class="nav-item">
            <span class="nav-icon">🔄</span>
            <span>Explain Loop</span>
          </a>
          <a href="/dashboard" class="nav-item">
            <span class="nav-icon">📊</span>
            <span>Dashboard</span>
          </a>
          <a href="/studio" class="nav-item">
            <span class="nav-icon">🎨</span>
            <span>AI Studio</span>
          </a>
          <a href="/metaverse" class="nav-item">
            <span class="nav-icon">🌐</span>
            <span>Metaverse</span>
          </a>
          <a href="/trading" class="nav-item">
            <span class="nav-icon">💹</span>
            <span>Trading</span>
          </a>
          <a href="/settings" class="nav-item">
            <span class="nav-icon">⚙️</span>
            <span>Settings</span>
          </a>
          <button id="logoutBtn" class="nav-item" style="background:none; border:none; width:100%; cursor:pointer; margin-top: 2rem; color: #ff4d4d;">
            <span class="nav-icon">🚪</span>
            <span>Logout</span>
          </button>
        </nav>
      </aside>
      
      <main class="main-content">
...
        <div class="content">
          <slot />
        </div>
      </main>
    </div>

    <script type="module">
      import { ApiClient } from '../lib/api';
      import { loadAnalytics } from '../lib/analytics';
      // Analytics
      loadAnalytics();

      // Logout
      const logoutBtn = document.getElementById('logoutBtn');
      logoutBtn?.addEventListener('click', () => {
        ApiClient.logout();
        window.location.href = '/login';
      });

      // Highlight active nav item
      const currentPath = window.location.pathname;
      const navItems = document.querySelectorAll('.nav-item');
      navItems.forEach(item => {
        if (item instanceof HTMLAnchorElement && item.getAttribute('href') === currentPath) {
          item.classList.add('active');
        }
      });
    </script>
  </body>
</html>
